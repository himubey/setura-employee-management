# ---------------------------------------------------------------------------
# Setura backend — environment variables
#
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real values.
#
# Nothing here is needed for `GET /health`, `/docs` or the test suite — the
# app starts and is explorable with an empty .env, and only fails when
# something actually reaches for the database.
# ---------------------------------------------------------------------------

# --- Database (Neon PostgreSQL) --------------------------------------------
# Neon dashboard → Project → Connection Details → "Pooled connection".
# Must use the psycopg 3 driver prefix and include sslmode=require:
#   postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# --- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Used for signing sessions/tokens once authentication is implemented.
SECRET_KEY=

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed browser origins. No trailing slashes.
# The Next.js dev server runs on port 3000.
CORS_ORIGINS=http://localhost:3000

# --- Storage (Cloudflare R2) ------------------------------------------------
# Not required until document upload is implemented.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
