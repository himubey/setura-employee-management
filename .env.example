# ---------------------------------------------------------------------------
# Setura Employee Management — environment variables
#
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored. NEVER commit real credentials.
# Every variable here is server-only: none are prefixed with NEXT_PUBLIC_,
# so none of them are exposed to the browser bundle.
# ---------------------------------------------------------------------------

# --- Database (Neon PostgreSQL) --------------------------------------------
# Neon dashboard -> Project -> Connection Details -> "Pooled connection".
# Must include `?sslmode=require`.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/setura?sslmode=require

# --- Authentication (Better Auth) ------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL of this app. Must match the deployed origin in production.
BETTER_AUTH_URL=http://localhost:3000

# --- Storage (Cloudflare R2) -----------------------------------------------
# Cloudflare dashboard -> R2 -> Manage API Tokens.
# Not required for local development until file uploads are implemented.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=setura-documents
# Public base URL for the bucket, if a public domain is attached. Optional.
R2_PUBLIC_URL=
