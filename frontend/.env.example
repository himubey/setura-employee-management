# ---------------------------------------------------------------------------
# Setura frontend — environment variables
#
# Copy this file to `.env.local` and adjust if needed.
#
# EVERY variable here is prefixed with NEXT_PUBLIC_ and is therefore inlined
# into the browser bundle. Backend secrets (DATABASE_URL, SECRET_KEY, the R2
# credentials) live in backend/.env and MUST NEVER appear in this file.
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend. No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Serve the UI from an in-memory fixture instead of calling the backend.
# Lets the frontend run standalone before the FastAPI service exists.
# Set to "false" once the backend is running (Phase 6).
NEXT_PUBLIC_USE_MOCK_API=true
